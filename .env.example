# App
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_MAX_CRAWL_CONCURRENCY=10
APP_MAX_PLAYWRIGHT_PAGES=5
APP_MAX_CRAWL_DEPTH=3
APP_REQUEST_TIMEOUT=30

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600
REDIS_SEARCH_CACHE_TTL=900
REDIS_ROBOTS_CACHE_TTL=86400

# PostgreSQL
POSTGRES_DSN=postgresql://user:password@postgres:5432/retrieval_db
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=retrieval_chunks
QDRANT_VECTOR_SIZE=384

# SearXNG
SEARXNG_URL=http://searxng:8080
SEARXNG_MAX_RESULTS=10

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DEVICE=cpu

# Reranker
# bge-reranker-base = memory-optimal (~1.1GB). For higher quality / multilingual,
# use BAAI/bge-reranker-v2-m3 (~2.3GB).
RERANKER_MODEL=BAAI/bge-reranker-base
# Keep false on CPU. Set true only when EMBEDDING_DEVICE=cuda.
RERANKER_USE_FP16=false
RERANKER_TOP_K=2

# ARQ Worker
ARQ_REDIS_URL=redis://redis:6379/1
ARQ_MAX_JOBS=20
ARQ_JOB_TIMEOUT=300
